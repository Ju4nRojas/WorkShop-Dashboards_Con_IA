// =====================================================================================
// Demo 3 · Medidas de REFERENCIA (para comparar con lo que escriba el agente; no hace falta copiarlas)
//
// ESTADO: no se probaron en Power BI Desktop. Están escritas siguiendo las guías DAX del skill
// semantic-model-authoring (VAR con prefijo _, DIVIDE, columnas con nombre de tabla, sin medidas dentro
// de filtros booleanos). Los resultados esperados salen de un cálculo independiente con pandas sobre el mismo CSV.
//
// Supuesto sobre el modelo: una tabla 'Despachos' importada de despachos_eds_mensual.csv, con las columnas
// anio, mes, departamento, producto, zona_frontera, volumen_gal, n_registros (tal como llegan del CSV).
// Si el agente renombra tabla o columnas (por ejemplo a "Volumen (gal)"), adapta los nombres.
//
// Resultados esperados (corte octubre de 2026):
//   Año de corte = 2026 · Mes de corte = 10
//   Volumen ene–corte (Mgal)        = 3.596,45
//   Volumen ene–corte (Mgal) (ly)   = 3.486,41
//   Variación interanual (%)        = +3,16 %
// =====================================================================================

// --- Medidas (créalas en la tabla 'Despachos') ---------------------------------------

Volumen (Mgal) =
DIVIDE ( SUM ( Despachos[volumen_gal] ), 1000000 )

Año de corte =
CALCULATE ( MAX ( Despachos[anio] ), REMOVEFILTERS ( Despachos ) )

Mes de corte =
VAR _anio = [Año de corte]
RETURN
    CALCULATE ( MAX ( Despachos[mes] ), REMOVEFILTERS ( Despachos ), Despachos[anio] = _anio )

Volumen ene–corte (Mgal) =
VAR _anio = [Año de corte]
VAR _mes = [Mes de corte]
RETURN
    CALCULATE ( [Volumen (Mgal)], Despachos[anio] = _anio, Despachos[mes] <= _mes )

Volumen ene–corte (Mgal) (ly) =
VAR _anio = [Año de corte] - 1
VAR _mes = [Mes de corte]
RETURN
    CALCULATE ( [Volumen (Mgal)], Despachos[anio] = _anio, Despachos[mes] <= _mes )

Variación interanual (%) =
VAR _actual = [Volumen ene–corte (Mgal)]
VAR _anterior = [Volumen ene–corte (Mgal) (ly)]
RETURN
    DIVIDE ( _actual - _anterior, _anterior )

// --- Consulta de validación (ejecútala con el MCP o en la vista de consultas DAX) ----------

EVALUATE
ROW (
    "Año de corte", [Año de corte],
    "Mes de corte", [Mes de corte],
    "Actual (Mgal)", [Volumen ene–corte (Mgal)],
    "Anterior (Mgal)", [Volumen ene–corte (Mgal) (ly)],
    "Variación", [Variación interanual (%)]
)

// Control extra (trampa de la comparación): si alguien suma TODO 2025, obtiene 4.219,3 Mgal y una "caída" falsa de −14,8 %.
